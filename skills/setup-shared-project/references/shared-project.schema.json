{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared project configuration v1",
  "type": "object",
  "required": ["schemaVersion", "toolkitVersion", "projectId", "bases", "paths", "apps"],
  "properties": {
    "schemaVersion": {"const": 1},
    "toolkitVersion": {"type": "string"},
    "projectId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{7,79}$"},
    "bases": {"type": "object", "additionalProperties": false, "properties": {"darwin": {"type": "string"}, "win32": {"type": "string"}, "linux": {"type": "string"}, "wsl": {"type": "string"}}},
    "paths": {"type": "object", "required": ["project"], "propertyNames": {"pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"}, "additionalProperties": {"$ref": "#/$defs/relative"}},
    "apps": {"type": "object", "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$"}, "additionalProperties": {"$ref": "#/$defs/app"}}
  },
  "$defs": {
    "relative": {"type": "string", "minLength": 1, "description": "Slash-separated relative path; no parent segments, drive or backslash. Native containment is additionally validated at runtime."},
    "selection": {"type": "array", "items": {"$ref": "#/$defs/relative"}},
    "command": {"oneOf": [
      {"type": "object", "required": ["script"], "additionalProperties": false, "properties": {"script": {"type": "string", "pattern": "^[a-zA-Z0-9_:.-]+$"}}},
      {"type": "object", "required": ["node"], "additionalProperties": false, "properties": {"node": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}
    ]},
    "app": {
      "type": "object",
      "required": ["path", "profile", "sources", "commands", "runtime"],
      "properties": {
        "path": {"$ref": "#/$defs/relative"},
        "profile": {"enum": ["npm", "npm-vite"]},
        "sources": {"allOf": [{"$ref": "#/$defs/selection"}], "minItems": 1},
        "exclude": {"$ref": "#/$defs/selection"},
        "restart": {"$ref": "#/$defs/selection"},
        "commands": {"type": "object", "additionalProperties": {"$ref": "#/$defs/command"}},
        "runtime": {"type": "object", "required": ["range", "fallback"], "properties": {"range": {"type": "string"}, "fallback": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}}},
        "buildOutput": {"$ref": "#/$defs/relative"},
        "exportPath": {"$ref": "#/$defs/relative"},
        "envPaths": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    }
  }
}
